# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:
DATABASE_URL=sqlite:///./tracker.db
# Cloud Run + Supabase (replace with your actual values):
# DATABASE_URL=postgresql://postgres:<your-db-password>@db.<your-project-ref>.supabase.co:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── Gmail Push / Pub/Sub ──────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
PUBSUB_TOPIC=gmail-push
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change-this-webhook-secret
# Set this AFTER Cloud Run deploy (no trailing slash):
PUBLIC_URL=

# ── Gmail credentials (Cloud Run only) ───────────────────────────────────────
# Paste the ENTIRE single-line JSON content of credentials.json:
CREDENTIALS_JSON=
# Paste the ENTIRE single-line JSON content of token.json:
TOKEN_JSON=
