# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:
DATABASE_URL=sqlite:///./tracker.db
# Cloud Run (replace with your Supabase connection string):
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── Gmail Push / Pub/Sub ──────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=finance-tracker-506109
PUBSUB_TOPIC=gmail-push
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change-this-webhook-secret
# Set after Cloud Run deploy:
PUBLIC_URL=

# ── Gmail credentials (Cloud Run only) ───────────────────────────────────────
# Paste the ENTIRE content of credentials.json on one line:
CREDENTIALS_JSON=
# Paste the ENTIRE content of token.json on one line:
TOKEN_JSON=
